# Trustonic TEE + keymint in recovery. This is what makes FBE decryption work,
# and therefore what makes a backup of internal storage non-empty.
#
# Derived from STOCK's own etc/init/trustonic.rc (paths rewritten), never from
# another recovery's ramdisk: importing from the artifact this replaces would
# smuggle back the dependency the project exists to remove.
#
# TRUSTLETS LIVE IN THE RAMDISK (this reverses the earlier "option 1" choice).
# The original plan mounted /vendor and passed -r paths into it, to save 8.5 MB.
# That cannot work here, for a reason that only showed up on the device:
# /vendor's own VINTF manifest declares manifest.version 5.0, and PBRP's
# libvintf is kMetaVersion{4,0}. The moment /vendor is mounted, its manifest
# shadows ours, libvintf rejects the whole file, and keystore2 SIGSEGVs on the
# null manifest. So /vendor must stay UNMOUNTED, and the 8.5 MB is the price of
# that. vendor_boot has room: the image was 31.5 MB of a 64 MiB partition.
#
# The paths below are unchanged from stock (/vendor/app/mcRegistry/...) and now
# resolve against the ramdisk copy instead of the real partition.
#
# [!] The stock rc passed 29 -r arguments; only 9 of those .drbin files exist
# in this device's blob set. mcDriverDaemon tolerates the missing ones silently,
# which is exactly why it went unnoticed. This list is generated from the files
# actually present.
#
# [!] --P1 /mnt/vendor/persist/mcRegistry is also required; persist must be
# mounted before mcDriverDaemon starts. That requirement is easy to miss from
# the recipe alone.

# [!] LET init BE HEARD. Added 2026-09-04, and it is a DIAGNOSTIC line, not a
# functional one -- but it is the reason a real defect in this file survived a
# full session of investigation, so it earns its place.
#
# /proc/sys/kernel/printk_devkmsg defaults to `ratelimit`, which the kernel
# applies PER OPEN FILE DESCRIPTION at 10 lines per 5 seconds. init holds one
# such description for its entire log. It spends the budget the moment second
# stage starts -- the ten lines ending "Couldn't load property file
# /system_ext/default.prop" -- and is then silent from t=2.16 to t=7.46. `on
# post-fs` runs at t=2.44, squarely inside that window, so every "processing
# action" line and every failed command with its file:line is dropped by the
# kernel before it reaches the ring buffer. `dmesg | grep` then reports a clean
# run of a block that failed. The boot log says so out loud if you look for it:
#     printk: init: 396 output lines suppressed due to ratelimiting
#
# That is BLUEPRINT.md section 9's "an empty variable makes every grep return 0,
# which reads as a clean pass", with the KERNEL doing the emptying rather than a
# shell. The absence of a log line is not evidence about init until the log is
# known to be lossless.
#
# Recovery has a short uptime and few /dev/kmsg writers, so the cost is a few
# hundred extra lines per boot. Verified writable at runtime on hardware.
on early-init
    write /proc/sys/kernel/printk_devkmsg on\n

on post-fs
    # persist is a plain physical partition; mount it early.
    #
    # [!] READ-WRITE, and that is not a relaxation -- it is load-bearing.
    # This said `ro` until 2026-09-03, reasoning "recovery has no business
    # writing the secure storage area, and metadata decryption was verified
    # working with it ro". Both halves were true and the conclusion was still
    # wrong, because the test only ever covered METADATA decryption. CREDENTIAL
    # decryption writes here: the Trustonic gatekeeper TA keeps its throttling
    # record in /mnt/vendor/persist/mcRegistry/failure_records.dat -- the path
    # is a literal string in libMcGatekeeper.so -- and with the mount ro,
    # verify() fails for EVERY password including the correct one. TWRP shows
    # only "Begin Operation failed", from the keystore call AFTER the failed
    # verify, so the message names the wrong layer.
    #
    # Measured on hardware 2026-09-03, both directions:
    #   ro : PIN 1234 (right) and 9999 (wrong) fail IDENTICALLY
    #   rw : 1234 -> "User 0 Decrypted Successfully", 9999 -> rejected,
    #        and failure_records.dat's mtime moves
    # Android mounts this rw as well, so this is matching it, not loosening it.
    wait /dev/block/by-name/persist 5
    mkdir /mnt/vendor/persist 0771 root root
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw nosuid nodev noatime
    # [!] START THEM HERE, EXPLICITLY. `class main` is NOT enough: recovery's
    # init never issues class_start, so a class-only service is never started
    # at all. Verified on the device -- `grep -rn class_start /init.rc
    # /system/etc/init/*.rc` returns NOTHING, mcDriverDaemon and keymint were
    # both absent at the TWRP main menu, and keystore2 was running only because
    # its own rc carries an explicit `on late-init / start keystore2`.
    #
    # This is the SECOND dead trigger in this file. The first was
    #     on property:twrp.vendor.mounted=1
    # a property nothing ever sets. Both failed the same silent way: init parses
    # the file, defines the services, and simply never runs them.
    #
    # `on post-fs` is used rather than `on late-init` because late-init fires
    # BEFORE post-fs, and mcDriverDaemon needs --P1 /mnt/vendor/persist/mcRegistry
    # which the mount directly above provides. Confirmed live: persist is
    # mounted at the main menu, so this trigger does fire.
    # ADOPT THE INSTALLED ROM'S KEYMINT IDENTITY BEFORE KEYMINT STARTS.
    #
    # keymint reads ro.build.version.release, ro.build.version.security_patch and
    # ro.vendor.build.security_patch ONCE, at its own startup, and binds/checks
    # key blobs against them. Baking them in at build time pins this recovery to
    # a single ROM -- which is exactly how it broke on 2026-08-24 when Tier B
    # moved the ROM's SPL to 2026-02-01 and this image still said 2024-09-05.
    #
    # `exec` and not `exec_start`: this MUST complete before keymint starts, and
    # exec blocks init's action queue while exec_start does not.
    #
    # The script is fail-silent by construction -- if the ROM cannot be read it
    # leaves the compiled-in BoardConfig values alone, so a wiped device still
    # gets a booting recovery.
    # [!] THIS EXEC NEVER RAN, ON ANY BUILD EVER SHIPPED, UNTIL 2026-09-04, AND
    # THE MISSING PIECE IS THE `u:r:recovery:s0` ON THE LINE ITSELF. It read
    #     exec -- /system/bin/sh /system/bin/sync-rom-spl.sh
    # with no seclabel, which makes init derive the child's domain for itself:
    #   service.cpp:829   a seclabel is only read when an argument PRECEDES `--`,
    #                     so `exec --` leaves seclabel_ empty
    #   service.cpp:583   an empty seclabel means ComputeContextFromExecutable(),
    #                     i.e. security_compute_create(u:r:init:s0, <sh>, process)
    #   init.te:17        domain_trans(init, rootfs,     recovery)
    #   init.te:22        domain_trans(init, shell_exec, shell)
    # Both of those are `domain_trans`, NOT `domain_auto_trans`. The macro pair at
    # te_macros:9-33 differs by exactly one line: domain_auto_trans adds the
    # `type_transition`, domain_trans does not. So no automatic transition exists
    # for either label, security_compute_create hands back init's OWN context,
    # service.cpp:90 calls that "incorrect label or no domain transition", and
    # under enforcing it returns an error instead of forking.
    #
    # Reproduced and measured in this recovery, 2026-09-04:
    #   getenforce                Enforcing
    #   /proc/1/attr/current      u:r:init:s0
    #   ls -Z /system/bin/sh      u:object_r:rootfs:s0
    #                             ^ the ramdisk cpio carries no xattrs, so EVERY
    #                               file here is rootfs -- not the shell_exec that
    #                               plat_file_contexts:459 declares for this path.
    #                               Read the label off the running device; the
    #                               file_contexts entry is not what applies here.
    #   getprop ro.rs4.spl_sync   empty
    #
    # `u:r:recovery:s0` is not a hopeful choice. It is the domain every other
    # service in this file already uses, init.te:17 gives it `entrypoint` on
    # exactly `rootfs`, and mcDriverDaemon enters it from /system/bin/mcDriverDaemon
    # -- same label, same init, two commands below this one -- on every boot
    # (pid 313, measured). Both halves were then proven on hardware: the script
    # re-run under `runcon u:r:recovery:s0` mounted system_b and vendor_b, read all
    # three properties, set ro.rs4.spl_sync=2026-02-01 and exited 0.
    #
    # 🪤 THE EARLIER INVESTIGATION RULED THIS OUT WITH "init logged no failure",
    # AND THAT WAS THE INSTRUMENT TALKING. init does log it -- action.cpp:170
    # reports every failed command with its file:line -- but at LOG(INFO) through
    # /dev/kmsg, which the kernel rate-limits. See the `on early-init` block above
    # for the whole mechanism; the short version is that init is silent from
    # t=2.16 to t=7.46, and `on post-fs` runs at t=2.44.
    #
    # The two `write /dev/kmsg` probes that bracketed this line have done their
    # job and are gone. They worked where init's own logger did not for a reason
    # worth keeping: the `write` builtin opens /dev/kmsg fresh each time, and the
    # rate limit is per open file description.
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/sync-rom-spl.sh early

    start mobicore
    start vendor.keymint-trustonic

    # [!] ro.hardware.gatekeeper LIVES IN /vendor/build.prop, AND /vendor IS
    # NEVER MOUNTED HERE (see the manifest note in vendor/etc/vintf/manifest.xml
    # for why it cannot be). So the property is EMPTY in recovery, and
    # libhardware's hw_get_module("gatekeeper") falls through its whole chain --
    # ro.hardware.gatekeeper, then ro.hardware (mt6789), then ro.product.board,
    # ro.board.platform, ro.arch, then "default" -- and none of
    # gatekeeper.mt6789.so / gatekeeper.default.so exist in this ramdisk.
    # Measured: with the two blobs staged but this line absent, the service
    # prints "Unable to open GateKeeper HAL" and takes SIGABRT.
    #
    # Stated here, not read off the installed ROM, because which TEE this device
    # has is a hardware fact -- and it must agree with the impl we ship.
    setprop ro.hardware.gatekeeper trustonic
    start vendor.gatekeeper-1-0

# [!] THE SECOND HALF OF THE SPL SYNC, AND IT EXISTS BECAUSE ONE PASS CANNOT
# WORK. Measured on hardware 2026-09-04, on the first boot where the exec above
# ever ran at all:
#     t=2.390  the `early` exec
#     t=2.645  mcDriverDaemon · 2.647 keymint · 2.649 gatekeeper
#     t=2.78   /system/bin/recovery maps and mounts the logical partitions
# The ROM lives on LOGICAL partitions and NOTHING maps them until TWRP does, so
# at post-fs there is nothing to read -- the log said `no device for system`.
# And it cannot be fixed by moving the exec later: `exec` blocks init's command
# queue, and the process that creates those nodes is started by init AFTER it,
# so a script that waited would deadlock the boot.
#
# So `late` reads the truth once TWRP has mapped the partitions and CACHES it on
# persist, and `early` adopts that cache next boot at a point where persist -- a
# physical partition, mounted rw two lines above the exec -- is readable and the
# ROM is not. Steady state is correct before keymint. Only the first boot after
# the ROM's SPL moves is not, and the restart below repairs that one in place.
#
# `start`, NOT `exec_start`. Both `exec` and `exec_start` go through
# Service::ExecStart() and set is_exec_service_running_, which blocks init's
# whole command queue (service.cpp:400, init.cpp:1002) -- so `exec_start` here
# would stall TWRP's own startup for as long as this waits. A plain `start`
# blocks nothing, which is why the script may wait for its device nodes.
#
# TRIGGER: twrp.super.symlinks_created is set by TWPartitionManager::
# Prepare_Super_Volume (partitionmanager.cpp:4202), called from Process_Fstab
# (:378). Decrypt_Data() is :587 and runs after, so this fires before any
# decrypt attempt. ⚠ It is set on the FIRST symlink created, not the last, which
# is why the script waits for the two nodes it actually needs.
#
# ⚠ THIS TRIGGER FIRES REPEATEDLY -- measured 6 times on one boot, t=2.845 to
# t=2.888, because TWRP sets the property once per super symlink it creates and
# init re-runs an action on every set. That is harmless twice over: `start` on a
# running service is a no-op (the service ran exactly ONCE, pid 351, 0.547 s,
# and all six firings landed inside that window), and a re-run would be
# idempotent anyway -- it would re-read the same values, adopt nothing because
# they are already set, and rewrite an identical cache. Recorded so the repeats
# are not later mistaken for a defect.
on property:twrp.super.symlinks_created=true
    start rs4-spl-late

# [!] RESTART KEYMINT ONLY IF A VALUE ACTUALLY MOVED. keymint reads the three
# properties ONCE at its own startup, so a value adopted after it started is not
# in effect until it restarts. But a restart lands in the middle of TWRP's
# startup, so it must not happen on a normal boot -- and it does not: the script
# sets this property only when an adopt changed something, which is only after
# the ROM's SPL has moved. Worst case if the race is lost anyway: one decrypt
# attempt fails and a retry succeeds, and the next boot needs no restart at all
# because `early` will have the cache.
on property:rs4.spl_changed=1
    restart vendor.keymint-trustonic

service rs4-spl-late /system/bin/sh /system/bin/sync-rom-spl.sh late
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service mobicore /system/bin/mcDriverDaemon --sfs-reformat --P1 /mnt/vendor/persist/mcRegistry \
	-r /vendor/app/mcRegistry/020f0000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/031c0000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/05070000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/05120000000000000000000000000001.drbin \
	-r /vendor/app/mcRegistry/06090000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/07170000000000000000000000000000.drbin \
	-r /vendor/app/mcRegistry/08050000000000000000000000003419.drbin \
	-r /vendor/app/mcRegistry/40188311faf343488db888ad39496f9a.drbin \
	-r /vendor/app/mcRegistry/5020170115e016302017012521300000.drbin
    class main
    user root
    group root system drmrpc
    seclabel u:r:recovery:s0

# keymint and gatekeeper follow mobicore in file order so init starts them
# after it. If one still loses the race it aborts and init restarts it, which
# is self-healing; the `interface` lines additionally let servicemanager
# lazy-start them on demand, which is how keystore2 reaches keymint.
service vendor.keymint-trustonic /system/bin/hw/android.hardware.security.keymint-service.trustonic
    interface aidl android.hardware.security.keymint.IKeyMintDevice/default
    interface aidl android.hardware.security.keymint.IRemotelyProvisionedComponent/default
    interface aidl android.hardware.security.secureclock.ISecureClock/default
    interface aidl android.hardware.security.sharedsecret.ISharedSecret/default
    class main
    user root
    seclabel u:r:recovery:s0

# GATEKEEPER -- required to decrypt /data whenever a screen lock IS set.
#
# [!] THIS WAS DELIBERATELY NOT STARTED UNTIL 2026-09-03, AND THAT SHIPPED A
# HANG TO USERS. The note here used to say it "buys nothing: gatekeeper
# authenticates a lockscreen credential, and this device has no screen lock, so
# TWRP takes the default-password path (Decrypt_Device("!")) which never calls
# it." Every word of that was true of the DEVELOPER'S phone, which has no
# credential, and false for everyone else's. A user with a PIN/pattern/password
# reported the recovery stuck on "Attempting to decrypt FBE for user 0..."
# forever, and that is precisely this path:
#
#   Decrypt_User -> Decrypt_User_Synth_Pass -> no .weaver file, so the secdis
#     branch -> IGatekeeper::getService()        system/vold/Decrypt.cpp:753
#
# getService() is the BLOCKING variant, and the interface IS declared in our
# vendor/etc/vintf/manifest.xml, so hwservicemanager keeps trying to lazy-start
# a service that no init file defines -- once a second, forever:
#   init: Control message: Could not find
#     'android.hardware.gatekeeper@1.0::IGatekeeper/default' for
#     ctl.interface_start from pid: 305 (/system/bin/hwservicemanager)
# TWRP displays no error because there is none: nothing failed, a call simply
# never returned. Same mechanism as the IBootControl hang in BLOBS-boot-hal.md.
# A HAL DECLARED in the manifest and registered by nobody is strictly worse
# than one that is absent, because the declaration is what makes the wait legal.
#
# [!] The old note also claimed shipping this "means importing a chain of system
# libs" -- libgatekeeper.so and libhardware.so, "NOT in the stock vendor blob
# set". That was measured wrong. Both are ALREADY in the shipped recovery
# ramdisk, built by PBRP itself, along with android.hardware.gatekeeper@1.0.so,
# libhidlbase, libutils and libc++; libMcClient.so is already carried for
# keymint. The real cost is TWO files, 35,760 bytes total:
#     system/lib64/hw/android.hardware.gatekeeper@1.0-impl.so   passthrough shim
#     system/lib64/hw/gatekeeper.trustonic.so                   = libMcGatekeeper.so
# Both from this device's own revision-28 vendor dump. That estimate is what
# justified deferring the work, so it is worth naming: the cost was overstated
# by an entire dependency chain that was already present, and nobody looked.
#
# [!] Shipped as a COPY named gatekeeper.trustonic.so, where stock uses a
# symlink to libMcGatekeeper.so. hw_get_module() dlopens it by that filename, so
# the copy is equivalent, and it removes a symlink that would otherwise have to
# survive the wholesale copy of recovery/root into the ramdisk. 19,800 bytes.
#
# The trustlet needs nothing new: all 28 of stock's mcRegistry files are already
# in this ramdisk, so tlTeeGatekeeper (TA version 100.258) loads as-is.
#
# Verified on hardware 2026-09-03, on the shipped 3.7.1_13 image, from a fresh
# boot, with the wrong password as a control:
#     9999 (wrong)  -> rejected, "Failed to decrypt user 0"
#     1234 (right)  -> "User 0 Decrypted Successfully", and /data/media/0 lists
#                      Alarms Android Audiobooks DCIM in PLAINTEXT
service vendor.gatekeeper-1-0 /system/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class main
    user root
    seclabel u:r:recovery:s0

# [!] The previous version gated all three of these on
#     on property:twrp.vendor.mounted=1
# That property does not exist. Nothing in bootable/recovery ever sets it, so
# the trigger never fired and none of these services ever started, which is why
# keymint was absent and TWRP hung in waitForService() before drawing its UI.
# Verified on the device: `getprop twrp.vendor.mounted` is empty at the TWRP
# main menu.
