# TWRP-specific flags. partitionmanager.cpp:276 reads /system/etc/twrp.flags.
# The MOUNTS live in recovery.fstab (Android format, so libfs_mgr can map the
# dynamic partitions); this file only adds display names and backup targets.
#
# ⚠ nvdata/nvcfg/protect1/protect2/nvram/proinfo carry the IMEI and radio
# calibration, and md1img is the modem image. A "full backup" that omits them
# restores a phone with no radio identity.
/system         erofs   /dev/block/mapper/system            flags=display="System";logical;slotselect;backup=1
/system_ext     erofs   /dev/block/mapper/system_ext        flags=display="System_ext";logical;slotselect;backup=1
/vendor         erofs   /dev/block/mapper/vendor            flags=display="Vendor";logical;slotselect;backup=1
/product        erofs   /dev/block/mapper/product           flags=display="Product";logical;slotselect;backup=1
/vendor_dlkm    ext4    /dev/block/mapper/vendor_dlkm       flags=display="Vendor_dlkm";logical;slotselect;backup=1
/odm_dlkm       ext4    /dev/block/mapper/odm_dlkm          flags=display="Odm_dlkm";logical;slotselect;backup=1
/data           f2fs    /dev/block/by-name/userdata         flags=display="Data";backup=1;wipeingui
/metadata       ext4    /dev/block/by-name/metadata         flags=display="Metadata";backup=1
/boot           emmc    /dev/block/by-name/boot             flags=display="Boot";slotselect;backup=1;flashimg=1
# [!] There is NO /init_boot entry, and there must not be. See the note in
# recovery.fstab: both slots read as 8 MiB of zeros and stock rev 28 ships no
# init_boot.img (scatter: is_download false, file_name NONE). It was listed here
# until 2026-09-07 and showed up as a phantom "Init Boot" in Backup and, worse,
# as a target in Flash Image.
/vendor_boot    emmc    /dev/block/by-name/vendor_boot      flags=display="Vendor Boot";slotselect;backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo             flags=display="Dtbo";slotselect;backup=1;flashimg=1
/md1img         emmc    /dev/block/by-name/md1img           flags=display="Modem";slotselect;backup=1;flashimg=1
/logo           emmc    /dev/block/by-name/logo             flags=display="Logo";slotselect;backup=1;flashimg=1
/mnt/vendor/nvdata     ext4  /dev/block/by-name/nvdata      flags=display="NVDATA";backup=1;wipeingui=0
/mnt/vendor/nvcfg      ext4  /dev/block/by-name/nvcfg       flags=display="NVCFG";backup=1;wipeingui=0
/mnt/vendor/persist    ext4  /dev/block/by-name/persist     flags=display="Persist";backup=1;wipeingui=0
/mnt/vendor/protect_f  ext4  /dev/block/by-name/protect1    flags=display="Protect_f";backup=1;wipeingui=0
/mnt/vendor/protect_s  ext4  /dev/block/by-name/protect2    flags=display="Protect_s";backup=1;wipeingui=0
/nvram          emmc    /dev/block/by-name/nvram            flags=display="NVRAM";backup=1;flashimg=1;wipeingui=0
/proinfo        emmc    /dev/block/by-name/proinfo          flags=display="Proinfo";backup=1;flashimg=1;wipeingui=0
# 🔴 mmcblk0, NOT mmcblk1 -- the same eMMC-template assumption that made the
# USB-OTG entry point at a 4 MB UFS boot LUN.
#
# On an eMMC device internal storage is mmcblk0, so the card is mmcblk1. Internal
# storage HERE is UFS (sda/sdb/sdc), so nothing occupies mmcblk0 and the card
# takes it. Measured in recovery 2026-08-20 -- there is exactly ONE MMC host:
#     /sys/class/mmc_host/mmc0 -> 11240000.mmc      (no mmc1 exists)
# and 11240000.mmc is the SD slot by the ROM's own reckoning:
#     fstab.mt6789:57  /devices/platform/soc/11240000.mmc* ...
#                      voldmanaged=sdcard1:auto,encryptable=userdata
# One host, unoccupied numbering -> an inserted card registers as mmcblk0 and its
# first partition as mmcblk0p1. mmcblk1 can never appear on this variant, so the
# old entry could never mount anything.
#
# (fstab.mt6789:58 also lists 11230000.msdc*, but no mmc host exists for it on
# this variant -- that entry is inert here.)
/external_sd    auto    /dev/block/mmcblk0p1  /dev/block/mmcblk0  flags=display="MicroSD";storage;wipeingui;removable
# 🔴 sdd, NOT sda. Measured on the device 2026-08-20, in recovery:
#     sda  8192 sectors (4 MB)     removable=0   UFS boot LUN 0
#     sdb  8192 sectors (4 MB)     removable=0   UFS boot LUN 1
#     sdc  500613120    (238 GB)   removable=0   UFS main LUN, all by-name partitions
# Internal storage on this device is UFS and occupies sda/sdb/sdc, so the OTG
# entry pointed at a partition of a 4 MB internal boot LUN -- sda1 does not even
# exist. TWRP found nothing, and the USB-OTG toggle in the Mount menu was inert.
# That is the reported symptom: "can't even toggle usb-otg on mount section".
#
# The old value came from an eMMC-device template, where internal storage is
# mmcblk0 and the first USB disk is sda. It is wrong on any UFS device.
#
# sdd is deterministic HERE, not a second guess: the three UFS LUNs are fixed
# and enumerate at boot, before any USB device can attach, so the first OTG disk
# is always the next letter. Confirmed by plugging the stick in:
#     scsi 1:0:0:0: Direct-Access  SanDisk  Cruzer Blade
#     sd 1:0:0:0: [sdd] 15232000 512-byte logical blocks: (7.80 GB/7.26 GiB)
#     sdd: sdd1
#     sd 1:0:0:0: [sdd] Attached SCSI removable disk
#
# The rest of the chain was verified at the same time and needs no changes:
# the port switches to host (MUSB "a_host", is_host=1) with an ordinary Type-C
# OTG adapter; the recovery kernel lists exfat in /proc/filesystems; and
# fsck.exfat/mkexfatfs/exfat-fuse all ship in the ramdisk. Mounting sdd1 by hand
# gave MOUNT_OK, a successful write, and a clean umount.
/usb_otg        auto    /dev/block/sdd1       /dev/block/sdd      flags=display="USB-OTG";storage;removable

# --- partitions added 2026-08-19 after operator review of the Advanced Wipe list.
#
# [!] `wipeingui=0` above is NOT the main fix. These partitions appeared in
# Advanced Wipe because recovery.fstab marked them `formattable`, and
# partition.cpp:1061 treats formattable and wipeingui identically:
#     case TWFLAG_WIPEINGUI:
#     case TWFLAG_FORMATTABLE:
#         Wipe_Available_in_GUI = val;
# `formattable` also authorises fs_mgr to REFORMAT a partition whose mount
# fails, which on nvdata means losing the IMEI. It has been removed from all of
# them in recovery.fstab; wipeingui=0 is the belt to that braces.
#
# backup=1 is kept deliberately: nvdata/nvcfg/protect* carry the radio
# calibration and IMEI, so they are the partitions most worth having a backup
# of. Backing up is safe; wiping is not.
/tranfs         ext4    /dev/block/by-name/tranfs           flags=display="Tranfs";backup=1;wipeingui=0
# frp DOES exist on this device: /dev/block/by-name/frp -> /dev/block/sdc6, 1 MiB.
# It was simply never listed, which is why it did not appear in the GUI.
/frp            emmc    /dev/block/by-name/frp              flags=display="FRP";backup=1;flashimg=1;wipeingui=0

# --- partitions added 2026-09-07, after a field report that the Backup list was
# missing partitions that exist and offering one that does not.
#
# Every entry below was decided by MEASURING the partition, not by reading the
# GPT: a by-name node proves a partition EXISTS, never that anything WROTE it.
# On this device four GPT entries are permanently empty -- 8/8/8/14 MiB read off
# them hashes equal to the same length of /dev/zero:
#     init_boot_a/_b   connsys_bt_a   connsys_wifi_a   connsys_gnss_a   otp
# (the connsys firmware lives in /vendor/firmware here, not in its partitions),
# and stock rev 28 declares every one of them `is_download: false, NONE`. None
# of them is listed. A backup of zeros is worse than no entry: it takes space
# and it makes a restore look complete.
#
# The two groups below are different in kind and that is why they are separated.
#
# 1. DEVICE-UNIQUE, and NOT in the firmware -- these cannot be re-obtained from
#    the stock zip, so they are the ones a backup exists for. The scatter marks
#    them `is_download: false` precisely because they are per-unit data:
#      dram_para  DRAM calibration     seccfg  lock state + rollback
#      sec1       secure ro area       tkv     key/trust store
#    (nvdata/nvcfg/nvram/persist/protect1/protect2/proinfo are already above.)
#
# 2. FIRMWARE, recoverable from ~/itel-RS4-S666LN-28 -- cheap to carry (~55 MB
#    total) and what makes the list read as complete to a user comparing it to
#    the scatter. `lk` is the bootloader: back it up, but note it is NOT given
#    flashimg -- writing LK from a recovery GUI is brick territory (BLUEPRINT
#    section 12), and the recovery path for a bad LK is Penumbra + BROM, which
#    a phone that will not boot cannot reach.
#
# vbmeta/vbmeta_system/vbmeta_vendor get flashimg as well as backup: they are
# the images users are most often told to flash (verity/verification flags),
# they are 8 MiB each, and a mismatched one is a no-boot that a stock-vbmeta
# reflash fixes in seconds.
/vbmeta         emmc    /dev/block/by-name/vbmeta           flags=display="Vbmeta";slotselect;backup=1;flashimg=1;wipeingui=0
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system    flags=display="Vbmeta_system";slotselect;backup=1;flashimg=1;wipeingui=0
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor    flags=display="Vbmeta_vendor";slotselect;backup=1;flashimg=1;wipeingui=0
/dram_para      emmc    /dev/block/by-name/dram_para        flags=display="DRAM para";backup=1;flashimg=1;wipeingui=0
/seccfg         emmc    /dev/block/by-name/seccfg           flags=display="Seccfg";backup=1;flashimg=1;wipeingui=0
/sec1           emmc    /dev/block/by-name/sec1             flags=display="Sec1";backup=1;flashimg=1;wipeingui=0
/tkv            emmc    /dev/block/by-name/tkv              flags=display="TKV";slotselect;backup=1;flashimg=1;wipeingui=0
/efuse          emmc    /dev/block/by-name/efuse            flags=display="Efuse";backup=1;flashimg=1;wipeingui=0
/flashinfo      emmc    /dev/block/by-name/flashinfo        flags=display="Flashinfo";backup=1;flashimg=1;wipeingui=0
/lk             emmc    /dev/block/by-name/lk               flags=display="LK (bootloader)";slotselect;backup=1;flashimg=1;wipeingui=0
/tee            emmc    /dev/block/by-name/tee              flags=display="TEE";slotselect;backup=1;flashimg=1;wipeingui=0
/gz             emmc    /dev/block/by-name/gz               flags=display="GZ";slotselect;backup=1;flashimg=1;wipeingui=0
/scp            emmc    /dev/block/by-name/scp              flags=display="SCP";slotselect;backup=1;flashimg=1;wipeingui=0
/sspm           emmc    /dev/block/by-name/sspm             flags=display="SSPM";slotselect;backup=1;flashimg=1;wipeingui=0
/spmfw          emmc    /dev/block/by-name/spmfw            flags=display="SPMFW";slotselect;backup=1;flashimg=1;wipeingui=0
/mcupm          emmc    /dev/block/by-name/mcupm            flags=display="MCUPM";slotselect;backup=1;flashimg=1;wipeingui=0
/dpm            emmc    /dev/block/by-name/dpm              flags=display="DPM";slotselect;backup=1;flashimg=1;wipeingui=0
/pi_img         emmc    /dev/block/by-name/pi_img           flags=display="PI img";slotselect;backup=1;flashimg=1;wipeingui=0
#
# ⚠ flashimg=1 on every one of the above is deliberate, on operator instruction
# 2026-09-07: "the overclocking community flashed their mcupm partition in order
# to increase the frequency clock, which means they need easy access to flash
# into it -- make everything visible in backup/restore flashable too."
# Corroborated: CPU_OC_MT6789_EMIKO_V2.zip writes a 129,376-byte mcupm_signed.img
# (exactly stock mcupm.img's size) to by-name/mcupm_a AND mcupm_b.
#
# 🔴 Two things a user of this menu has to know, because the UI cannot say them:
#   1. Flash Image writes the ACTIVE SLOT ONLY. The OC zip writes both on
#      purpose -- an OTA that switches slots lands on an un-overclocked mcupm.
#      Flashing here is a per-slot action; do it again after a slot switch.
#   2. `lk` is the BOOTLOADER and `efuse`/`seccfg`/`sec1` are security state.
#      A bad write to lk is not a bootloop, it is a BROM-only device -- the way
#      back is Penumbra + DAMT6789.bin (BLUEPRINT section 12), which needs a PC.
#      They are listed because the operator asked for parity between the two
#      menus, not because flashing them is routine.

# --- raw-image twins for the ext4 device-data partitions, same 2026-09-07 ask.
# These carry the IMEI and radio calibration, and the reason to want a RAW
# target for them is exactly the reason they are backed up: restoring a dump
# after an nvdata loss. They cannot take flashimg on their own line -- they are
# set up as file systems, and partition.cpp:3371 refuses an image for those --
# so they get the same *_image twin the logical partitions use below.
/nvdata_image    emmc /dev/block/by-name/nvdata    flags=display="NVDATA Image";flashimg=1;backup=0;wipeingui=0
/nvcfg_image     emmc /dev/block/by-name/nvcfg     flags=display="NVCFG Image";flashimg=1;backup=0;wipeingui=0
/persist_image   emmc /dev/block/by-name/persist   flags=display="Persist Image";flashimg=1;backup=0;wipeingui=0
/protect_f_image emmc /dev/block/by-name/protect1  flags=display="Protect_f Image";flashimg=1;backup=0;wipeingui=0
/protect_s_image emmc /dev/block/by-name/protect2  flags=display="Protect_s Image";flashimg=1;backup=0;wipeingui=0
/tranfs_image    emmc /dev/block/by-name/tranfs    flags=display="Tranfs Image";flashimg=1;backup=0;wipeingui=0
#
# /data and /metadata get NO image twin. /data is 244 GB, and a raw /metadata
# restore puts back an encryption state that no longer matches /data -- that is
# not a restore, it is a wipe with extra steps.
#
# NOT listed, on purpose:
#   expdb      134 MiB of crash-dump ring buffer. Nothing to restore.
#   misc/para/boot_para   the bootloader control block. Restoring a STALE BCB
#              is not neutral -- it is an instruction to the bootloader.
#   otp, connsys_*, init_boot   measured empty, see above.

# --- Flash Image targets for the LOGICAL partitions, added 2026-09-07 on
# operator request: "those partitions are exposed on shell but not on the UI,
# which is tedious to use".
#
# TWRP will not flash a raw image to a partition it has set up as a FILE SYSTEM
# -- partition.cpp:3371 `if (Backup_Method == BM_FILES) "Cannot flash images to
# file systems"` -- so `flashimg=1` on the /vendor line above would put the
# entry in the menu and then refuse at the swipe. The mechanism TWRP does
# provide is a SECOND entry for the same block device declared as an image:
# fs type `emmc` -> Is_Image() -> Setup_Image() -> BM_DD -> Raw_Read_Write.
# `/system_image` and `/vendor_image` are names partition.cpp:605-614 already
# knows; the other four follow the same pattern.
#
# These are twrp.flags-only entries with no recovery.fstab line, which works
# because Process_Fstab "adds any items from twrp.flags that did not exist in
# the recovery.fstab" -- and Setup_Super_Devices() runs BEFORE that loop, so
# /dev/block/mapper/* already exists when they are resolved.
#
# Verified on hardware 2026-09-07, in recovery: all twelve mapper nodes are
# mapped READ-WRITE (blockdev --getro = 0) on both slots, so no RO flag has to
# be cleared first -- and patch 0005 covers the case where one is not.
#     system_a 521,125,888   vendor_a 752,861,184   product_a  601,976,832
#     system_ext_a 207,294,464   vendor_dlkm_a 37,150,720   odm_dlkm_a 348,160
#
# ⚠ Those sizes are the CURRENT extent, and Flash_Image refuses an image larger
# than it ("Size of image is larger than target device"). That is correct: a raw
# write cannot grow a logical partition, only lpmake/update_engine can. An image
# taken from a build of this same ROM fits; one from a different ROM may not.
#
# backup is deliberately off: the Super entry already backs these up, and a
# second, raw, 521 MB "System Image" in the same list is a trap, not a feature.
/system_image      emmc /dev/block/mapper/system      flags=display="System Image";slotselect;flashimg=1;backup=0;wipeingui=0
/system_ext_image  emmc /dev/block/mapper/system_ext  flags=display="System_ext Image";slotselect;flashimg=1;backup=0;wipeingui=0
/vendor_image      emmc /dev/block/mapper/vendor      flags=display="Vendor Image";slotselect;flashimg=1;backup=0;wipeingui=0
/product_image     emmc /dev/block/mapper/product     flags=display="Product Image";slotselect;flashimg=1;backup=0;wipeingui=0
/vendor_dlkm_image emmc /dev/block/mapper/vendor_dlkm flags=display="Vendor_dlkm Image";slotselect;flashimg=1;backup=0;wipeingui=0
/odm_dlkm_image    emmc /dev/block/mapper/odm_dlkm    flags=display="Odm_dlkm Image";slotselect;flashimg=1;backup=0;wipeingui=0
