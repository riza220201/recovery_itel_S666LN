# The Backup list lists five partitions TWICE, and shows raw mount points for
# every partition the recovery.fstab also declares.
#
# Reported from the field (notes/bug_report2.2.png): the Backup list carries
#   mnt/vendor/persist  mnt/vendor/nvdata  mnt/vendor/nvcfg
#   mnt/vendor/protect_f  mnt/vendor/protect_s          <- from recovery.fstab
# AND, further down the same list,
#   NVCFG  NVDATA  Persist  Protect_f  Protect_s        <- from twrp.flags
# — ten entries for five partitions — while vendor_boot, dtbo, md1img, logo,
# frp, nvram, proinfo and tranfs appear under their raw mount-point names even
# though twrp.flags gives every one of them a display name.
#
# Both halves were reproduced on the host before this was written, by running
# PBRP's own parser code (partitionmanager.cpp Process_Fstab + partition.cpp
# Process_Fstab_Line + twrp-functions.cpp Get_Root_Path, copied verbatim) over
# the twrp.flags and recovery.fstab taken OUT of the shipped artifact. It
# reproduces the reporter's screenshot exactly, including the alphabetical
# order of the five duplicates — std::map iteration order, which is the tell
# that they come from the twrp.flags map and not from the fstab.
#
# DEFECT 1 — the duplicates.
#   Process_Fstab ends with "add any items from twrp.flags that did not exist
#   in the recovery.fstab", and asks that question with
#   Find_Partition_By_Path(). That function runs its argument through
#   TWFunc::Get_Root_Path() first, which truncates a path at its SECOND slash:
#       /mnt/vendor/nvdata  ->  /mnt
#   No partition is mounted at /mnt, so the answer is always NULL for a nested
#   mount point, and the entry is added a second time. It is not specific to
#   this device: any twrp.flags line whose mount point has more than one path
#   component hits it.
#
# DEFECT 2 — the names.
#   For an Android-format (v2) fstab line, TWRP applies the twrp.flags entry in
#   a second pass at the end of Process_Fstab_Line, by calling Process_TW_Flags
#   directly. Apply_TW_Flag's TWFLAG_DISPLAY sets Display_Name and NOTHING
#   else; Backup_Display_Name keeps the default assigned when the mount point
#   was parsed (mount point minus its leading slash). Both the Backup list and
#   the Flash Image list render Backup_Display_Name
#   (partitionmanager.cpp Get_Partition_List, "backup" and "flashimg"), so the
#   display name never reaches either menu. The v1 path 20 lines above already
#   does the propagation — Display_Name -> Backup_Display_Name/Storage_Name
#   when the flags did not set them explicitly — which is why twrp.flags-only
#   entries (MCUPM, LK, the *_image twins) DO show their real names. This adds
#   the same propagation to the v2 path; the code is copied from that block so
#   the two paths cannot drift.
#
# 🔑 Why this is worth a patch rather than a `backupname=` on every line: the
#    data-only workaround fixes the symptom on one device's flags file and
#    leaves the next maintainer to rediscover why `display=` "does nothing".
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -393,7 +393,22 @@
 		// Add any items from twrp.flags that did not exist in the recovery.fstab
 		for (std::map<string, Flags_Map>::iterator mapit = twrp_flags.begin();
 				 mapit != twrp_flags.end(); mapit++) {
-			if (Find_Partition_By_Path(mapit->first) == NULL) {
+			// Find_Partition_By_Path() answers about the ROOT of a path
+			// (Get_Root_Path: "/mnt/vendor/nvdata" -> "/mnt"), so for a NESTED
+			// mount point it can never match the entry the recovery.fstab
+			// already created, and every one of them got added a second time.
+			// Ask the exact question this loop actually means.
+			bool already_have = Find_Partition_By_Path(mapit->first) != NULL;
+			if (!already_have) {
+				for (std::vector<TWPartition*>::iterator iter = Partitions.begin();
+						 iter != Partitions.end(); iter++) {
+					if ((*iter)->Mount_Point == mapit->first) {
+						already_have = true;
+						break;
+					}
+				}
+			}
+			if (!already_have) {
 				TWPartition* partition = new TWPartition();
 				if (partition->Process_Fstab_Line(mapit->second.fstab_line, Display_Error, NULL))
 					Partitions.push_back(partition);
--- a/partition.cpp
+++ b/partition.cpp
@@ -656,7 +656,32 @@
 				skip += strlen("flags=");
 			char* flagptr = twrpflags;
 			flagptr += skip;
+			// display= sets Display_Name and nothing else, but the Backup and
+			// Flash Image lists both render Backup_Display_Name -- so without
+			// the same propagation the v1 path does above, every partition that
+			// is in BOTH recovery.fstab and twrp.flags shows its raw mount
+			// point there while the twrp.flags-only ones show their real names.
+			string Prev_Display_Name = Display_Name;
+			string Prev_Storage_Name = Storage_Name;
+			string Prev_Backup_Display_Name = Backup_Display_Name;
+			Display_Name = "";
+			Storage_Name = "";
+			Backup_Display_Name = "";
 			Process_TW_Flags(flagptr, Display_Error, 1); // Forcing the fstab to ver 1 because this data is coming from the /etc/twrp.flags which should be using the TWRP v1 flags format
+			bool tw_has_display_name = !Display_Name.empty();
+			bool tw_has_storage_name = !Storage_Name.empty();
+			bool tw_has_backup_name = !Backup_Display_Name.empty();
+			if (!tw_has_display_name) Display_Name = Prev_Display_Name;
+			if (!tw_has_storage_name) Storage_Name = Prev_Storage_Name;
+			if (!tw_has_backup_name) Backup_Display_Name = Prev_Backup_Display_Name;
+			if (tw_has_display_name && !tw_has_storage_name)
+				Storage_Name = Display_Name;
+			if (!tw_has_display_name && tw_has_storage_name)
+				Display_Name = Storage_Name;
+			if (tw_has_display_name && !tw_has_backup_name && Backup_Display_Name != "Android Secure")
+				Backup_Display_Name = Display_Name;
+			if (!tw_has_display_name && tw_has_backup_name)
+				Display_Name = Backup_Display_Name;
 		}
 	}
 
