diff --git a/twrpRepacker.cpp b/twrpRepacker.cpp
index 28a2a6c..f99c093 100644
--- a/twrpRepacker.cpp
+++ b/twrpRepacker.cpp
@@ -119,6 +119,73 @@ static bool is_AB_for_repacker() {
 	return !slot.empty();
 }
 
+
+// --- Post-repack control, ported from this device's PBRP flashable-zip installer.
+//
+// vendor_boot v4 carries TWO ramdisk fragments and only the recovery one is ours.
+// The PLATFORM fragment holds the kernel modules and the touch firmware, and PBRP's
+// own platform fragment is FOUR BYTES -- so an image that loses it boots to a touch
+// UI with no touch input. A partition write is not the place to discover that the
+// repack went wrong, which is why the zip installer verifies before it writes.
+//
+// Deliberately a PRESENCE-AND-SIZE check rather than a hash compare. magiskboot may
+// recompress a fragment during repack -- Flash_Current_Twrp() hands it a freshly
+// gzip'd ramdisk while the image's own fragments are lz4 -- so byte identity is NOT
+// guaranteed on a CORRECT repack, and asserting it would false-fail a working
+// feature. Size cannot lie about the failure that actually matters: compression
+// never turns megabytes into four bytes.
+static bool VerifyRepackedVendorBoot(const std::string& repack_dir, const std::string& ramdisk_cpio) {
+	const std::string verify_dir = repack_dir + "verify/";
+	const unsigned long kMinFragment = 1000000UL;
+
+	TWFunc::Exec_Cmd("rm -rf " + verify_dir, false);
+	if (TWFunc::Exec_Cmd("mkdir -p " + verify_dir, false) != 0) {
+		LOGERR("repack control: cannot create %s\n", verify_dir.c_str());
+		return false;
+	}
+	if (TWFunc::Exec_Cmd("cp -f " + repack_dir + "new-boot.img " + verify_dir, false) != 0) {
+		LOGERR("repack control: cannot stage new-boot.img for verification\n");
+		return false;
+	}
+	if (TWFunc::Exec_Cmd("cd " + verify_dir + " && /system/bin/magiskboot unpack -n new-boot.img", false) != 0) {
+		LOGERR("repack control: the repacked image does not unpack -- refusing to flash it\n");
+		TWFunc::Exec_Cmd("rm -rf " + verify_dir, false);
+		return false;
+	}
+
+	// magiskboot 28+ writes vendor_ramdisk/<name>.cpio; older writes
+	// vendor_ramdisk_<name>.cpio, the platform one having the empty name.
+	unsigned long rec = TWFunc::Get_File_Size(verify_dir + ramdisk_cpio);
+	if (rec == 0)
+		rec = TWFunc::Get_File_Size(verify_dir + "vendor_ramdisk/recovery.cpio");
+
+	unsigned long plat = TWFunc::Get_File_Size(verify_dir + "vendor_ramdisk_.cpio");
+	if (plat == 0)
+		plat = TWFunc::Get_File_Size(verify_dir + "vendor_ramdisk/.cpio");
+	unsigned long orig_plat = TWFunc::Get_File_Size(repack_dir + "vendor_ramdisk_.cpio");
+	if (orig_plat == 0)
+		orig_plat = TWFunc::Get_File_Size(repack_dir + "vendor_ramdisk/.cpio");
+
+	TWFunc::Exec_Cmd("rm -rf " + verify_dir, false);
+
+	LOGINFO("repack control: recovery fragment %lu B, platform fragment %lu B (was %lu B)\n",
+		rec, plat, orig_plat);
+
+	if (rec < kMinFragment) {
+		LOGERR("repack control FAILED: recovery fragment is %lu B -- refusing to flash\n", rec);
+		return false;
+	}
+	// Only assert the platform fragment when the image being repacked HAD one:
+	// a plain /boot repack legitimately has none.
+	if (orig_plat >= kMinFragment && plat < kMinFragment) {
+		LOGERR("repack control FAILED: platform fragment went from %lu B to %lu B -- "
+		       "touch firmware would be lost, refusing to flash\n", orig_plat, plat);
+		return false;
+	}
+	LOGINFO("repack control OK (recovery replaced, platform fragment intact)\n");
+	return true;
+}
